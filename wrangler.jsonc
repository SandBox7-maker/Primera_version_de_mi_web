{
// Debe coincidir con el nombre que le darás en Cloudflare
"name": "primera-version-de-mi-web",
// Pon la fecha de hoy
"compatibility_date": "2026-11-24",

"workers_dev" : true,
"preview_urls" : true,

"assets": {
// La carpeta que genera tu build
"directory": "./",
// Muestra tu página 404.html cuando una dirección no existe
"not_found_handling": "404-page"
}

}
